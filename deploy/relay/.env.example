# Copy to an operator-owned, non-versioned .env file; never commit its values.
# Public DNS must resolve to this host; inbound TCP 80/443 must reach Caddy.
RDP_RELAY_HOST=
RDP_RELAY_ACME_EMAIL=
# Generate with: python -c "from relay.protocol import new_token; print(new_token())"
# Store the result privately. There is deliberately no example/default key.
RDP_RELAY_ADMIN_KEY=
