@echo off
setlocal
rem Removal preserves monitoring policies, backups, recovery state and credentials.
powershell.exe -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; $record=Join-Path $env:ProgramData 'RDPMonitor\deployment.json'; if (-not (Test-Path -LiteralPath $record)) { throw 'No installed RDPMonitor deployment was found' }; $pin=Join-Path $env:ProgramFiles 'RDPMonitor\publisher.cer'; $d=Get-Content -LiteralPath $record -Raw | ConvertFrom-Json; $thumb=if (Test-Path -LiteralPath $pin) { (New-Object Security.Cryptography.X509Certificates.X509Certificate2($pin)).Thumbprint } else { $d.publisher_thumbprint.Replace(' ','').ToUpperInvariant() }; if ($d.publisher_thumbprint.Replace(' ','').ToUpperInvariant() -ne $thumb) { throw 'Deployment record does not match the pinned publisher' }; $path=Join-Path $d.release 'scripts\install_suite.ps1'; $s=Get-AuthenticodeSignature -LiteralPath $path; if ($s.Status -ne 'Valid' -or $s.SignerCertificate.Thumbprint -ne $thumb) { throw 'Untrusted installed removal script' }; & $path -Remove -PublisherThumbprint $thumb; if (-not $?) { exit 1 }"
exit /b %errorlevel%
